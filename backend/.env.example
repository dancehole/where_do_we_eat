# 高德地图
# Web 服务 Key：后端服务端 IP 定位 / 地理编码用
AMAP_WEB_KEY=
# JS API Key：H5 端加载地图与浏览器定位用（构建期注入）
AMAP_JS_KEY=
# JS API 安全密钥：JSAPI 加载前设置 securityJsCode，否则 Web 服务报 10008
AMAP_SECURITY_CODE=

# 微信小程序
WECHAT_APPID=
WECHAT_SECRET=

# 大模型（OpenAI 兼容，默认 DeepSeek；后期换模型只改下面三项）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=eat_where

# 如需覆盖上面的 MySQL 连接，可直接写完整 URL（例如本地用 SQLite 调试）：
# DATABASE_URL=sqlite:///./dev.db

# 前端基础地址（用于生成可分享的 H5 链接；留空则由前端从 window.location.origin 构造）
FRONTEND_BASE=
